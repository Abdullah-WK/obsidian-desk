{
  "appearance": {
    "rounding": {
      "scale": 0.5
    },
    "spacing": {
      "scale": 0.85
    },
    "padding": {
      "scale": 0.85
    },
    "anim": {
      "durations": {
        "scale": 0.7
      }
    },
    "transparency": {
      "enabled": false
    },
    "font": {
      "clock": "JetBrainsMono Nerd Font",
      "workspaces": "Inter",
      "headline": {
        "family": "Inter"
      },
      "title": {
        "family": "Inter"
      },
      "body": {
        "family": "Inter"
      },
      "label": {
        "family": "Inter"
      },
      "mono": {
        "family": "JetBrainsMono Nerd Font"
      }
    }
  },
  "general": {
    "showOverFullscreen": false,
    "apps": {
      "terminal": [
        "foot"
      ],
      "explorer": [
        "thunar"
      ]
    },
    "idle": {
      "lockBeforeSleep": true,
      "inhibitWhenAudio": true,
      "timeouts": [
        {
          "timeout": 900,
          "idleAction": [
            "qs",
            "-c",
            "onyx",
            "ipc",
            "call",
            "lock",
            "lock"
          ]
        },
        {
          "timeout": 1800,
          "idleAction": "dpms off",
          "returnAction": "dpms on"
        }
      ]
    }
  },
  "background": {
    "enabled": true,
