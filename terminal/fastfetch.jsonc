{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "color": {
            "1": "38;2;{{ primary.red }};{{ primary.green }};{{ primary.blue }}",
            "2": "38;2;{{ primary.red }};{{ primary.green }};{{ primary.blue }}"
        },
        "padding": {
            "left": 3,
            "right": 4,
            "top": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": "38;2;{{ onSurface.red }};{{ onSurface.green }};{{ onSurface.blue }}",
        "constants": [
            "\u001b[38;2;{{ onSurface.red }};{{ onSurface.green }};{{ onSurface.blue }}m",
            "\u001b[38;2;{{ primary.red }};{{ primary.green }};{{ primary.blue }}m",
            "\u001b[38;2;{{ secondary.red }};{{ secondary.green }};{{ secondary.blue }}m",
            "\u001b[38;2;{{ tertiary.red }};{{ tertiary.green }};{{ tertiary.blue }}m"
        ]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│   uptime",
            "text": "uptime -p | cut -d ' ' -f 2- | sed 's/ hours\\?/h/; s/ minutes\\?/m/; s/ days\\?/d/'",
            "format": "{>22} │"
        },
        {
            "type": "shell",
            "key": "│ {$2}{$1}  shell ",
            "format": "{$2}{pretty-name>22}{$1} │"
        },
        {
            "type": "packages",
            "key": "│   pkgs  ",
            "format": "{all>22} │"
        },
        {
            "type": "command",
            "key": "│ {$3}{$1}  mem   ",
            "text": "free -m | awk 'NR==2{printf \"%.1f / %.1f GiB\",$3/1024,$2/1024}'",
            "format": "{$3}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$3}{$1}  disk  ",
            "text": "df -h / | awk 'NR==2{printf \"%s / %s\", $3, $5}'",
            "format": "{$3}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$4}{$1}  cpu   ",
            "text": "for h in /sys/class/hwmon/hwmon*; do case $(cat $h/name) in coretemp|k10temp|zenpower) printf '%dC' $(( $(cat $h/temp1_input) / 1000 )); break;; esac; done",
            "format": "{$4}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$4}{$1}  gpu   ",
            "text": "d=$(ls -d /sys/bus/pci/drivers/nvidia/0000* 2>/dev/null | head -1); if [ -n \"$d\" ] && [ \"$(cat $d/power/runtime_status)\" = active ]; then printf '%sC' $(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits); else echo asleep; fi",
            "format": "{$4}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$4}{$1}  batt  ",
            "text": "b=/sys/class/power_supply/BAT0; [ -d $b ] && printf '%s%% %s' $(cat $b/capacity) $(cat $b/status | tr 'A-Z' 'a-z') || echo none",
            "format": "{$4}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}{$1}  user  ",
            "text": "echo $USER",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│   hname ",
            "text": "hostnamectl hostname",
            "format": "{>22} │"
        },
        {
            "type": "os",
            "key": "│ {$4}󰣇{$1}  distro",
            "format": "{$4}{pretty-name>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "│                                   │"
        },
        {
            "type": "custom",
            "key": "│   \u001b[38;2;{{ surfaceContainerHigh.red }};{{ surfaceContainerHigh.green }};{{ surfaceContainerHigh.blue }}m■ \u001b[38;2;{{ outlineVariant.red }};{{ outlineVariant.green }};{{ outlineVariant.blue }}m■ \u001b[38;2;{{ primaryContainer.red }};{{ primaryContainer.green }};{{ primaryContainer.blue }}m■ \u001b[38;2;{{ outline.red }};{{ outline.green }};{{ outline.blue }}m■ \u001b[38;2;{{ onSurfaceVariant.red }};{{ onSurfaceVariant.green }};{{ onSurfaceVariant.blue }}m■ \u001b[38;2;{{ primary.red }};{{ primary.green }};{{ primary.blue }}m■ \u001b[38;2;{{ tertiary.red }};{{ tertiary.green }};{{ tertiary.blue }}m■{$1}                  │"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}
